# Copy to .env and replace placeholders with strong random secrets.
POSTGRES_DB=investhelper
POSTGRES_USER=investhelper
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_UNIQUE_ACCESS_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production-only operator-attested public redistribution allowlist. Empty is deny-all.
# Set ONLY after separately verifying contract terms; no wildcard support.
INVESTHELPER_PUBLIC_DATA_PROVIDERS=
