# Copy to .env on the server (chmod 600). Do not commit real credentials.
# Use independently generated alphanumeric secrets; URL-reserved characters in
# POSTGRES_PASSWORD need percent-encoding in the SQLAlchemy URL built by Compose.
POSTGRES_DB=investhelper
POSTGRES_USER=investhelper
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_ALPHANUMERIC_32_PLUS
MINIO_ROOT_USER=stageoperator
MINIO_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_GENERATED_ALPHANUMERIC_32_PLUS
# Explicitly empty: no provider content is approved for redistribution.
INVESTHELPER_PUBLIC_DATA_PROVIDERS=
